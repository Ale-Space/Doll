% ---------- elementi grafici interni ----------
% etichetta dei riquadri: icona + testo maiuscoletto spaziato
\DeclareRobustCommand{\doll@etichetta}[3]{%
  {\sffamily\bfseries\footnotesize\color{#1}%
   \ifstrempty{#2}{}{\faIcon{#2}\hspace{0.5em}}%
   \textls[60]{\MakeUppercase{#3}}}}
% numero in un cerchietto pieno
\DeclareRobustCommand{\doll@pallino}[2]{%
  \tikz[baseline=(n.base)]\node[circle, fill=#1, text=white, inner sep=0pt,
    minimum size=1.35em, font=\sffamily\bfseries\footnotesize] (n) {#2};}
% "pillola" colorata (tipo di documento, timestamp)
\DeclareRobustCommand{\doll@pillola}[3]{%
  \tikz[baseline=(n.base)]\node[rounded corners=2pt, fill=#1, text=#2, inner xsep=4pt,
    inner ysep=2.2pt, font=\sffamily\bfseries\footnotesize] (n) {#3};}

% ---------- stili dei riquadri ----------
\tcbset{
  doll/base/.style={
    enhanced, breakable, frame hidden, sharp corners,
    interior style={fill=#1!5!white},
    borderline west={2.8pt}{0pt}{#1},
    left=11pt, right=11pt, top=6pt, bottom=7pt,
    before skip=8pt plus 2pt, after skip=8pt plus 2pt,
    parbox=false,
    before upper={\setlength{\parskip}{0.4em}\setlength{\abovedisplayskip}{5pt plus 2pt}\setlength{\belowdisplayskip}{5pt plus 2pt}},
  },
  doll/formale/.style={
    enhanced, breakable, sharp corners, boxrule=0.7pt,
    colframe=#1, colback=#1!3!white,
    colbacktitle=#1, coltitle=white,
    fonttitle=\sffamily\bfseries\normalsize,
    toptitle=3pt, bottomtitle=3pt, lefttitle=11pt,
    left=11pt, right=11pt, top=6pt, bottom=7pt,
    before skip=10pt plus 2pt, after skip=10pt plus 2pt,
    parbox=false,
    before upper={\setlength{\parskip}{0.4em}\setlength{\abovedisplayskip}{5pt plus 2pt}\setlength{\belowdisplayskip}{5pt plus 2pt}},
  },
}

% ---------- idea ----------
\NewTColorBox{idea}{O{Idea chiave}}{doll/base=dollarancio,
  before upper*={\doll@etichetta{dollarancio}{lightbulb}{#1}\par\nobreak\vspace{1pt}}}

% ---------- metodo: passi numerati ----------
\NewDocumentEnvironment{metodo}{O{Metodo generale}}
  {\begin{tcolorbox}[doll/base=dollviola,
     before upper*={\doll@etichetta{dollviola}{list-ol}{#1}\par\nobreak\vspace{1pt}}]%
   \begin{enumerate}[label={\doll@pallino{dollviola}{\arabic*}}, leftmargin=2.1em,
     labelsep=0.6em, itemsep=0.45em, topsep=0.2em]}
  {\end{enumerate}\end{tcolorbox}}

% ---------- passo della soluzione ----------
\newcounter{dollpasso}
\newcommand{\azzerapassi}{\setcounter{dollpasso}{0}}
\NewDocumentEnvironment{passo}{m}
  {\refstepcounter{dollpasso}%
   \begin{tcolorbox}[doll/base=dollblu,
     before upper*={{\doll@pallino{dollblu}{\thedollpasso}\hspace{0.55em}%
       {\sffamily\bfseries\color{dollblu}#1}}\par\nobreak\vspace{1pt}}]}
  {\end{tcolorbox}}
% il "perche'" di un passo
\newcommand{\perche}[1]{%
  \par\smallskip
  {\color{dollblu!70!black}\sffamily\bfseries\footnotesize\textls[60]{PERCH\'E}}\hspace{0.6em}%
  {\color{dolltesto!85!dollblu}#1}\par}

% ---------- attenzione ----------
\NewTColorBox{attenzione}{O{Attenzione all'esame}}{doll/base=dollrosso,
  before upper*={\doll@etichetta{dollrosso}{exclamation-triangle}{#1}\par\nobreak\vspace{1pt}}}

% ---------- risultato ----------
\NewTColorBox{risultato}{O{Risultato}}{enhanced, breakable, sharp corners,
  boxrule=1pt, colframe=dollverde, colback=dollverde!6!white,
  left=12pt, right=12pt, top=6pt, bottom=8pt,
  before skip=11pt, after skip=11pt, parbox=false,
  before upper*={{\doll@etichetta{dollverde}{check-circle}{#1}}\par\nobreak\smallskip\centering
    \setlength{\parskip}{0.4em}}}

% ---------- teorema e definizione ----------
\NewTColorBox{teorema}{m}{doll/formale=dollblu,
  title={\faIcon{bookmark}\hspace{0.55em}Teorema\ifstrempty{#1}{}{ \textperiodcentered\ #1}}}
\NewTColorBox{definizione}{m}{doll/formale=dollviola,
  title={\faIcon{feather-alt}\hspace{0.55em}Definizione\ifstrempty{#1}{}{ \textperiodcentered\ #1}}}

% ---------- dimostrazione ----------
\NewTColorBox{dimostrazione}{O{Dimostrazione}}{doll/base=dolltenue,
  interior style={fill=dollsfondo},
  before upper*={\doll@etichetta{dolltenue}{pen-nib}{#1}\par\nobreak\vspace{1pt}},
  after upper={\ifhmode\unskip\nobreak\fi\hfill\nobreak\textcolor{dolltenue}{$\blacksquare$}}}

% ---------- controesempio, esempio ----------
\NewTColorBox{controesempio}{O{Controesempio}}{doll/base=dollrosso,
  interior style={fill=white}, borderline west={2.8pt}{0pt}{dollrosso, dashed},
  before upper*={\doll@etichetta{dollrosso}{times-circle}{#1}\par\nobreak\vspace{1pt}}}

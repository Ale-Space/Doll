% ---------- didattica: obiettivi, previsione, preconcetto, autoverifica, ripasso ----------
\NewTColorBox{obiettivi}{O{Cosa saprai fare}}{doll/base=dollblu,
  before upper*={\doll@etichetta{dollblu}{bullseye}{#1}\par\nobreak\vspace{1pt}}}
\NewTColorBox{previsione}{O{Prima di leggere: prova a prevedere}}{doll/base=dollviola,
  before upper*={\doll@etichetta{dollviola}{question-circle}{#1}\par\nobreak\vspace{1pt}}}
\NewTColorBox{preconcetto}{O{Il preconcetto da smontare}}{doll/base=dollrosso,
  before upper*={\doll@etichetta{dollrosso}{exclamation-circle}{#1}\par\nobreak\vspace{1pt}}}
\NewTColorBox{ripasso}{O{Ripasso: rifallo tra 2 giorni e tra una settimana}}{doll/base=dolltenue,
  before upper*={\doll@etichetta{dolltenue}{redo}{#1}\par\nobreak\vspace{1pt}}}
\def\doll@soluzioni{}
\long\def\doll@aggiungisol#1{\g@addto@macro\doll@soluzioni{\item #1}}
\newcommand{\soluzione}[1]{\doll@aggiungisol{#1}}
\NewDocumentEnvironment{autoverifica}{O{Verifica te stesso}}
  {\begin{tcolorbox}[doll/base=dollverde, interior style={fill=white},
     before upper*={\doll@etichetta{dollverde}{brain}{#1}\par\nobreak\vspace{1pt}}]%
   \begin{enumerate}[label={\doll@pallino{dollverde}{\arabic*}}, leftmargin=2.1em,
     labelsep=0.6em, itemsep=0.35em, topsep=0.2em]}
  {\end{enumerate}\par\smallskip
   {\sffamily\footnotesize\color{dolltenue}\faIcon{arrow-right}\ rispondi senza guardare: le soluzioni sono in fondo alla dispensa}%
   \end{tcolorbox}}
\newcommand{\dollsoluzioni}[1][Soluzioni di \guillemotleft Verifica te stesso\guillemotright]{%
  \ifx\doll@soluzioni\@empty\else
    \section*{#1}%
    {\small\begin{enumerate}[label=\arabic*., itemsep=0.3em]\doll@soluzioni\end{enumerate}}%
    \global\let\doll@soluzioni\@empty
  \fi}
\newcommand{\vuoto}[1][4em]{\underline{\hspace{#1}}}

% ---------- esercizio con risposta in fondo ----------
\newcounter{dollesercizio}
\def\doll@risposte{}
\newcommand{\doll@unarisposta}[2]{%
  \par\noindent\hypertarget{doll@risp@#1}{}%
  \label{doll@risp@#1}%
  {\hypersetup{linkcolor=dollverde}\sffamily\bfseries\small\hyperlink{doll@es@#1}{\faIcon{pencil-alt}\ Esercizio #1}}\par\nobreak
  \vspace{0.15em}#2\par\medskip}
\newcommand{\risposta}[1]{%
  \edef\doll@n{\thedollesercizio}%
  \expandafter\doll@aggiungirisp\expandafter{\doll@n}{#1}%
  % link alla risposta: in fondo all'ultima riga se c'e' spazio, altrimenti a capo a destra
  \unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfill
  {\sffamily\footnotesize
   \hyperlink{doll@risp@\doll@n}{\faIcon{arrow-right}\ risposta a pagina \pageref*{doll@risp@\doll@n}}}%
  {\parfillskip=0pt\par}}
\long\def\doll@aggiungirisp#1#2{\g@addto@macro\doll@risposte{\doll@unarisposta{#1}{#2}}}
\NewTColorBox{esercizio}{O{}}{doll/base=dollverde,
  interior style={fill=white},
  borderline west={2.8pt}{0pt}{dollverde},
  borderline={0.5pt}{0pt}{dollbordo},
  code={\refstepcounter{dollesercizio}},
  before upper*={\hypertarget{doll@es@\thedollesercizio}{}%
    \doll@etichetta{dollverde}{pencil-alt}{Esercizio \thedollesercizio}%
    \ifstrempty{#1}{}{\hspace{0.6em}{\sffamily\small\color{dolltenue}#1}}\par\nobreak\vspace{1pt}}}
\newcommand{\dollrisposte}[1][Risposte agli esercizi]{%
  \ifx\doll@risposte\@empty\else
    \section*{#1}%
    {\small\doll@risposte}
    \global\let\doll@risposte\@empty
  \fi}
\AtEndDocument{\ifx\doll@risposte\@empty\else\dollrisposte\fi\ifx\doll@soluzioni\@empty\else\dollsoluzioni\fi}

% ---------- nel video / nella pagina interattiva ----------
\NewTColorBox{nelvideo}{O{}}{doll/base=dolltesto,
  interior style={fill=dollsfondo},
  before upper*={\doll@etichetta{dolltesto}{play-circle}{Cosa guardare}%
    \ifstrempty{#1}{}{\hfill{\ttfamily\footnotesize\color{dolltenue}\detokenize{#1}}}\par\nobreak\vspace{1pt}}}
\newcommand{\momento}[2]{%
  \par\noindent\hangindent=4.4em\hangafter=1
  \makebox[4.4em][l]{\doll@pillola{dolltesto}{white}{\faIcon{play}\,#1}}#2\par}
\newcommand{\statoweb}[2]{%
  \par\noindent\hangindent=4.4em\hangafter=1
  \makebox[4.4em][l]{\doll@pillola{dollblu}{white}{\faIcon{mouse-pointer}\,#1}}#2\par}

% ---------- blocco del titolo ----------
\def\doll@col@Esercizio{dollblu}
\def\doll@col@Teorema{dollviola}
\def\doll@col@Concetto{dollverde}
\def\doll@col@Definizione{dollviola}
\newcommand{\dolltitolo}[3]{%
  \gdef\doll@titolo{#1}\gdef\doll@corso{#2}%
  \ifcsname doll@col@#3\endcsname
    \edef\doll@coltipo{\csname doll@col@#3\endcsname}%
  \else\def\doll@coltipo{dollarancio}\fi
  \hypersetup{pdftitle={#1}, pdfsubject={#2}}%
  \thispagestyle{dollprima}%
  \vspace*{-0.6cm}%
  {\noindent\doll@pillola{\doll@coltipo}{white}{\textls[60]{\MakeUppercase{#3}}}%
   \hfill{\sffamily\footnotesize\color{dolltenue}\textls[40]{DOLL\,\textperiodcentered\,DISPENSA}}\par}%
  \vspace{10pt}%
  {\noindent\raggedright\sffamily\bfseries\fontsize{23}{28}\selectfont\color{dolltesto}#1\par}%
  \vspace{5pt}%
  {\noindent\raggedright\sffamily\fontsize{12}{15}\selectfont\color{dolltenue}#2\par}%
  \vspace{9pt}%
  {\noindent\color{\doll@coltipo}\rule{2.2cm}{2.2pt}\color{dollbordo}\rule[0.8pt]{\dimexpr\linewidth-2.2cm\relax}{0.6pt}\par}%
  \vspace{4pt}}

% ---------- figure ----------
\newcommand{\doll@segnaposto}[3]{% larghezza, rapporto h/w, nome file
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1, #2*#1); % il bordo non deve sporgere
    \path[draw=dollbordo!80!dolltenue, dashed, line width=0.7pt, fill=dollsfondo, rounded corners=3pt]
      (0,0) rectangle (#1, #2*#1);
    \node[align=center, font=\sffamily\footnotesize, text=dolltenue, text width=0.85*#1]
      at (0.5*#1, 0.5*#2*#1) {\faIcon{image}\\[2pt] figura non ancora disponibile\\[1pt]
      {\ttfamily\scriptsize\detokenize{#3}}};
  \end{tikzpicture}}
\newcommand{\doll@immagine}[4]{% larghezza, file, altezza max, rapporto h/w del segnaposto
  \IfFileExists{#2}%
    {\includegraphics[width=#1, height=#3, keepaspectratio]{#2}}%
    {\doll@segnaposto{#1}{#4}{#2}}}

\NewDocumentCommand{\dollfigura}{O{0.8} m m}{%
  \par\begin{center}
  \doll@immagine{#1\linewidth}{#2}{0.42\textheight}{0.35}%
  \ifstrempty{#3}{}{\captionof{figure}{#3}}%
  \end{center}\par}

% due blocchi affiancati, centrati in verticale (testo | figura, schema | domande, ...)
% \dollaccanto[frazione del primo blocco = 0.5]{primo}{secondo}
\NewDocumentCommand{\dollaccanto}{O{0.5} +m +m}{%
  \par\smallskip\noindent
  \begin{minipage}[c]{\dimexpr#1\linewidth-0.02\linewidth\relax}\raggedright\setlength{\parskip}{0.4em}#2\end{minipage}\hfill
  \begin{minipage}[c]{\dimexpr\linewidth-#1\linewidth-0.02\linewidth\relax}\centering #3\end{minipage}%
  \par\smallskip}

\def\doll@delim{::}
\ExplSyntaxOn
\seq_new:N \l__doll_parti_seq
\tl_new:N \l__doll_file_tl
\tl_new:N \l__doll_cap_tl
\int_new:N \l__doll_n_int
\dim_new:N \l__doll_w_dim
\cs_new_protected:Npn \__doll_split:n #1
  {
    \exp_args:NNV \seq_set_split:Nnn \l__doll_parti_seq \doll@delim {#1}
    \seq_pop_left:NNF \l__doll_parti_seq \l__doll_file_tl { \tl_clear:N \l__doll_file_tl }
    \seq_pop_left:NNF \l__doll_parti_seq \l__doll_cap_tl { \tl_clear:N \l__doll_cap_tl }
  }
\cs_new_protected:Npn \__doll_fotogramma:nn #1 #2
  {
    \__doll_split:n {#1}
    \begin{minipage}[t]{\l__doll_w_dim}
      \centering
      \exp_args:NnV \doll@immagine {\l__doll_w_dim} \l__doll_file_tl {0.3\textheight} {0.5625}
      \par\vspace{3pt}
      {\small\sffamily\bfseries\color{dollblu}(#2)}
      \tl_if_empty:NF \l__doll_cap_tl
        { ~ {\small \tl_use:N \l__doll_cap_tl} }
    \end{minipage}
  }
\NewDocumentCommand{\dollfotogrammi}{O{} m G{} G{}}
  {
    \int_set:Nn \l__doll_n_int { 1 }
    \tl_if_blank:nF {#3} { \int_incr:N \l__doll_n_int }
    \tl_if_blank:nF {#4} { \int_incr:N \l__doll_n_int }
    \dim_set:Nn \l__doll_w_dim
      { \int_case:nn { \l__doll_n_int } { {1}{0.55\linewidth} {2}{0.44\linewidth} {3}{0.31\linewidth} } }
    \par\begin{center}
    \__doll_fotogramma:nn {#2} {a}
    \tl_if_blank:nF {#3} { \hspace{0.03\linewidth} \__doll_fotogramma:nn {#3} {b} }
    \tl_if_blank:nF {#4} { \hspace{0.03\linewidth} \__doll_fotogramma:nn {#4} {c} }
    \par
    \tl_if_blank:nF {#1} { \vspace{2pt}\captionof{figure}{#1} }
    \end{center}\par
  }
\ExplSyntaxOff


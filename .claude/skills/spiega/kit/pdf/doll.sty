% =====================================================================
%  doll.sty  --  stile delle dispense PDF di Doll (skill "spiega")
% =====================================================================
%  Uso:   \documentclass[11pt]{article}
%         \usepackage{doll}
%  Si compila con pdflatex (scripts/pdf_build.sh mette kit/pdf nel TEXINPUTS).
%
%  TITOLO      \dolltitolo{Titolo}{Corso / argomento}{Esercizio|Teorema|Concetto}
%
%  RIQUADRI (tutti spezzabili tra le pagine)
%   \begin{idea} ... \end{idea}                      idea chiave (arancio)
%   \begin{metodo}[titolo] \item ... \end{metodo}    metodo generale, passi numerati (viola)
%   \begin{passo}{titolo} ... \perche{...} \end{passo}   un passo della soluzione (blu, numerato)
%   \begin{attenzione}[titolo] ... \end{attenzione}  errori tipici all'esame (rosso)
%   \begin{risultato}[titolo] ... \end{risultato}    risultato finale (verde, centrato)
%   \begin{teorema}{nome} ... \end{teorema}          enunciato (blu); nome vuoto {} = solo "Teorema"
%   \begin{definizione}{nome} ... \end{definizione}  definizione (viola)
%   \begin{dimostrazione}[titolo] ... \end{dimostrazione}   chiude con il quadratino
%   \begin{controesempio}[titolo] ... \end{controesempio}   (rosso)
%   \begin{esempio}[titolo] ... \end{esempio}         (giallo)
%   \begin{esercizio}[titolo] testo \risposta{...} \end{esercizio}
%        la risposta NON compare nel riquadro: va nella sezione "Risposte" in fondo
%        (stampata da \dollrisposte, o automaticamente a fine documento), con link.
%   \begin{nelvideo}[percorso video o pagina] \momento{0:12}{...} \statoweb{3}{...} \end{nelvideo}
%
%  DIDATTICA (guide/didattica.md)
%   \begin{obiettivi} Saprai ... Prerequisiti: ... \end{obiettivi}        cosa saprai fare (blu)
%   \begin{previsione} domanda ... \end{previsione}         prima di leggere: prova a prevedere (viola)
%   \begin{preconcetto} l'errore tipico e perche' e' falso \end{preconcetto}   (rosso)
%   \begin{autoverifica} \item domanda \soluzione{...} \item ... \end{autoverifica}
%        domande numerate; le soluzioni vanno in fondo ("Soluzioni di Verifica te stesso")
%   \begin{ripasso} \begin{itemize}\item ...\end{itemize} \end{ripasso}   da rifare tra 2 giorni e 1 settimana
%   \vuoto[larghezza]     spazio da completare negli esercizi guidati
%
%  AFFIANCATI  \dollaccanto[0.5]{testo o formule}{figura, schema o grafico}  (centrati in verticale)
%
%  FIGURE (non fanno mai fallire la compilazione: se il file manca c'e' un segnaposto)
%   \dollfigura[frazione larghezza=0.8]{file}{didascalia}
%   \dollfotogrammi[didascalia comune]{file1 :: didascalia1}{file2 :: didascalia2}{file3 :: didascalia3}
%        da 1 a 3 argomenti; " :: didascalia" e' facoltativo.
%
%  MACRO MATEMATICHE  \R \N \Z \Q \C  \polare{50}{53.13} (= 50/_53,13 gradi)  \abs{x} \norm{v} \dd (differenziale) \jj (unita'
%   immaginaria j)  \fasore{V} (fasore, barra sopra)  \e (numero di Nepero)
%  VIRGOLA: con icomma "2,5" e' un decimale; negli intervalli e nelle coppie metti lo spazio:
%   $[a, b]$, $[0, 4]$, $(1, 1)$ (senza spazio [0,4] diventerebbe "zero virgola quattro").
%  UNITA' (siunitx, virgola decimale)  \qty{2,5}{\ohm}  \num{0.6}  \ang{53.13}
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{doll}[2026/11/07 Doll: dispense di esercizi e teoremi]

